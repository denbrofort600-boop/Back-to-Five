var w = 1152;  // Ширина фонового элемента (в пикселях)
var h = 1152;  // Высота фонового элемента (в пикселях)
image_index = 0;  // Устанавливаем начальный кадр анимации для первого спрайта
// Отрисовываем первый фоновый элемент
draw_sprite(sprite_index, image_index, bg_x0, 0);  // Рисуем спрайт: используем текущий sprite_index, кадр image_index, позиция по X — bg_x0, по Y — 0
image_index += 1;  // Переходим к следующему кадру анимации для следующего элемента
// Отрисовываем второй фоновый элемент
draw_sprite(sprite_index, image_index, bg_x1, 0);
image_index += 1;
// Отрисовываем третий фоновый элемент
draw_sprite(sprite_index, image_index, bg_x2, 0);
image_index += 1;
// Отрисовываем четвёртый фоновый элемент
draw_sprite(sprite_index, image_index, bg_x3, 0);
image_index += 1;
// Отрисовываем пятый фоновый элемент
draw_sprite(sprite_index, image_index, bg_x4, 0);
// Проверяем, вышел ли первый фоновый элемент за левую границу экрана (полностью ушёл за пределы видимости)
if (bg_x0 < -1152) {
    bg_x0 += 1152 * 3;  // Перемещаем элемент вправо на 3 ширины (3456 пикселей), чтобы «зациклить» фон
}
// Аналогичная проверка и перемещение для второго фонового элемента
if (bg_x1 < -1152) {
    bg_x1 += 1152 * 3;
}
// Аналогичная проверка и перемещение для третьего фонового элемента
if (bg_x2 < -1152) {
    bg_x2 += 1152 * 3;
}
// Аналогичная проверка и перемещение для четвёртого фонового элемента
if (bg_x3 < -1152) {
    bg_x3 += 1152 * 3;
}
// Аналогичная проверка и перемещение для пятого фонового элемента
if (bg_x4 < -1152) {
    bg_x4 += 1152 * 3;
}